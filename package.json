{
  "name": "thecatrave",
  "private": true,
  "type": "module",
  "description": "Static site for thecatrave: page generators and the quality-gate test suite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "analytics:export": "node scripts/export-organic-analytics.mjs",
    "genres:catalog": "node scripts/genres-from-catalog-dump.mjs",
    "genres:youtube": "node scripts/genres-from-youtube-metadata.mjs",
    "genres:experiment": "node scripts/genre-background-worker.mjs",
    "genres:background": "node scripts/start-genre-background.mjs",
    "genres:status": "node scripts/genre-background-status.mjs",
    "genres:promote": "node scripts/promote-genre-experiment.mjs",
    "genres:popular": "node scripts/start-genre-background.mjs --popular",
    "genres:popular-status": "node scripts/genre-background-status.mjs --popular",
    "genres:popular-promote": "node scripts/promote-genre-experiment.mjs --popular",
    "genres:prune": "node scripts/prune-non-sets.mjs",
    "genres:title-artists": "node scripts/build-title-artist-cache.mjs",
    "genres:store": "node scripts/start-store-genre-background.mjs",
    "genres:store-status": "node scripts/store-genre-status.mjs",
    "genres:refine": "node scripts/start-genre-refinement.mjs",
    "genres:refine-status": "node scripts/genre-refinement-status.mjs",
    "genres:priority": "node scripts/start-priority-enrichment.mjs",
    "genres:priority-status": "node scripts/priority-enrichment-status.mjs",
    "serve": "node scripts/serve.mjs 4173 .",
    "audit": "node audit-all.mjs",
    "check:html": "node scripts/check.mjs html",
    "check:links": "node scripts/check.mjs links",
    "check:layout": "node scripts/check.mjs layout",
    "check:vitals": "node scripts/check.mjs vitals",
    "check": "node scripts/require-node.mjs && node scripts/check.mjs",
    "test": "npm run check",
    "check:audit": "node scripts/check.mjs audit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "html-validate": "^9.5.3",
    "linkinator": "^6.1.2",
    "unlighthouse": "^0.16.3"
  }
}
