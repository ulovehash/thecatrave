{
  "name": "thecatrave",
  "private": true,
  "type": "module",
  "description": "Static site for thecatrave: page generators and the quality-gate test suite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs 4173 .",
    "audit": "node audit-all.mjs",
    "check:html": "html-validate index.html breakbeat-guide.html jungle-music-guide.html uk-electronic-music-evolution.html bass-music-guide.html dubstep-guide.html drum-and-bass-guide.html",
    "check:links": "linkinator http://localhost:4173 --recurse --skip \"^https?://(?!localhost)\"",
    "check:layout": "playwright test",
    "check:vitals": "unlighthouse-ci --site http://localhost:4173 --config-file unlighthouse.config.ts",
    "check": "node scripts/require-node.mjs && node scripts/check.mjs",
    "test": "npm run check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "html-validate": "^9.5.3",
    "linkinator": "^6.1.2",
    "unlighthouse": "^0.16.3"
  }
}
